{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noImplicitOverride": true
  },
  "angularCompilerOptions": {"strictTemplates": true, "strictInjectionParameters": true},
  "include": ["src/**/*.ts"]
}
